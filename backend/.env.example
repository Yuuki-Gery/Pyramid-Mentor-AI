# ============================================================
# Pyramid Mentor AI - environment template
# Copy this file to backend/.env and fill in your own values.
# NEVER commit backend/.env.
# ============================================================

# ---------- Application ----------
APP_NAME=Pyramid Mentor AI
# development | production
# production requires a strong JWT_SECRET_KEY and disables debug endpoints.
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Redis ----------
# Docker Compose: use the service name `redis`.
# Native local run: use 127.0.0.1.
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Chroma ----------
# Docker Compose: use the service name `chromadb`.
# Native local run: use 127.0.0.1 and map port 8000 as needed.
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ---------- LLM provider ----------
# Supported values: agnes | openai | deepseek
# The Claude key below is reserved; no Anthropic client is implemented yet.
LLM_PROVIDER=agnes

# Agnes (default provider)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# OpenAI or any OpenAI-compatible endpoint.
# OPENAI_BASE_URL may be left empty to use the official OpenAI endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# DeepSeek (uses https://api.deepseek.com internally)
DEEPSEEK_API_KEY=

# Reserved for a future provider implementation.
ANTHROPIC_API_KEY=

# Model name understood by the selected provider.
# Default example matches the project's default Agnes model.
DEFAULT_MODEL=agnes-2.0-flash

# ---------- Database ----------
# Defaults to a local SQLite file. Tables are created on first startup.
DATABASE_URL=sqlite+aiosqlite:///./pyramid.db

# ---------- JWT ----------
# Required in production. Generate a random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Development falls back to a clearly-marked insecure key when this is empty.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---------- CORS ----------
# Comma-separated explicit origins. Wildcards are rejected because credentials
# are enabled. Add your deployed frontend origin in production.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------- Debug endpoints ----------
# Enables /llm-test, /agent-test, /rag-test, /knowledge-load* and /api/expert/*.
# Always forced off when ENVIRONMENT=production.
ENABLE_DEBUG_ENDPOINTS=true
